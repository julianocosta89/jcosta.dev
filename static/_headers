/*
  # Security Headers
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

  # Content Security Policy
  # Adjust as needed for your specific requirements
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com/@dash0/sdk-web@0.28.3/dist/dash0.iife.js https://unpkg.com/@dash0/sdk-web@0.28.3/dist/dash0-session-recording.iife.js; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://ingress.eu-west-1.aws.dash0.com; frame-src https://open.spotify.com https://docs.google.com https://www.youtube.com https://app.netlify.com; media-src 'self' https://open.spotify.com;

  # Cache Control for static assets
  Cache-Control: public, max-age=31536000, immutable

/posts/*
  # Cache HTML pages for shorter time
  Cache-Control: public, max-age=3600, must-revalidate

/talks/*
  # Cache HTML pages for shorter time
  Cache-Control: public, max-age=3600, must-revalidate

/*.html
  # Cache HTML pages for shorter time
  Cache-Control: public, max-age=3600, must-revalidate

/
  # Homepage cache
  Cache-Control: public, max-age=1800, must-revalidate
